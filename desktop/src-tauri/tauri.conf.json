{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lacus",
  "version": "../package.json",
  "identifier": "com.yetang.dim",
  "build": {
    "frontendDist": "../../staging/macos-app/boot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Lacus (野塘漫水) local agent workspace",
    "icon": ["../../staging/macos-app/icons/icon.icns", "../../staging/macos-app/icons/icon.png"],
    "externalBin": ["../../staging/macos-app/dimcode"],
    "resources": {
      "../../staging/macos-app/web/": "web/",
      "../../staging/macos-app/plugins-payload/": "plugins-payload/",
      "../../staging/macos-app/licenses/": "licenses/",
      "../../staging/macos-app/build-info.json": "build-info.json"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "files": {
        "Resources/zh_CN.lproj/InfoPlist.strings": "locales/zh_CN.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings"
      }
    }
  }
}
