{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lacus",
  "version": "../package.json",
  "identifier": "com.yetang.dim",
  "build": {
    "frontendDist": "../../staging/macos-app/boot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5RENFRTNGRDY0MkJGN0YKUldSL3YwTFdQKzdjU1NPYTdsajhzVXUraXU2VWg1TTdWRE9zenNzYzNNa0lVTDBYOG0zSE4yVkQK",
      "endpoints": ["https://github.com/yq1930/dim/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Lacus local agent workspace",
    "icon": ["../../staging/macos-app/icons/icon.icns", "../../staging/macos-app/icons/icon.png"],
    "externalBin": ["../../staging/macos-app/dimcode"],
    "resources": {
      "../../staging/macos-app/web/": "web/",
      "../../staging/macos-app/plugins-payload/": "plugins-payload/",
      "../../staging/macos-app/licenses/": "licenses/",
      "../../staging/macos-app/build-info.json": "build-info.json"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
